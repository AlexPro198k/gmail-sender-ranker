{
  "manifest_version": 3,
  "name": "Gmail Sender Ranker",
  "version": "2.1.0",
  "key": "",
  "description": "Rank Gmail Inbox senders and create Delete/Block rules for them.",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://mail.google.com/*", "https://gmail.googleapis.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Rank Gmail senders",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
